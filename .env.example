# Backend environment configuration (example)
#
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit the real `.env` — it is git-ignored.

# BFF listen port
PORT=3001

# REQUIRED. PostgreSQL connection string for the BFF's OWN database.
#
# This must be a database dedicated to the BFF — never the Open Horizon Exchange's
# own database. Both define a `users` table with incompatible shapes, and the BFF's
# startup migration would attempt to drop the Exchange's primary key. See docs/DATABASE.md.
#
# The BFF talks to the Exchange over HTTP (EXCHANGE_URL); it never needs Exchange
# database credentials.
DATABASE_URL=postgresql://nereid:nereidpass@postgres:5432/nereid

# Redis connection string (used by the `redis` service in docker-compose.yaml)
REDIS_URL=redis://redis:6379

# Session idle lifetime in seconds (30 minutes)
SESSION_TTL=1800

# Master key for AES-256-GCM encryption of Exchange credentials at rest.
# MUST be a 32-byte value encoded as 64 hex characters.
# If empty, the server generates and persists a key in `.session.key` (0600).
# In production, ALWAYS set this via a secret so the key survives restarts
# and is not auto-generated per host.
SESSION_ENC_KEY=

# Open Horizon Exchange base URL (optional default; the user supplies this at login)
# EXCHANGE_URL=http://192.168.123.133:3090
