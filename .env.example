# Backend environment configuration (example)
#
# Copy this file to `.env` and adjust values for your environment.
# NEVER commit the real `.env` — it is git-ignored.

# BFF listen port
PORT=3001

# REQUIRED. PostgreSQL connection string for the BFF's OWN database.
#
# This must be a database dedicated to the BFF — never the Open Horizon Exchange's
# own database. Both define a `users` table with incompatible shapes, and the BFF's
# startup migration would attempt to drop the Exchange's primary key. See docs/DATABASE.md.
#
# The BFF talks to the Exchange over HTTP; it never needs Exchange database
# credentials. Sessions are also stored here, so sessions survive backend restarts.
DATABASE_URL=postgresql://nereid:nereidpass@postgres:5432/nereid

# Session idle lifetime in seconds (24 hours).
SESSION_TTL=86400

# Absolute session lifetime in seconds (8 hours), independent of activity.
SESSION_ABS_TTL=28800

# Master key for AES-256-GCM encryption of session payloads (including Exchange
# credentials) at rest. MUST be a 32-byte value encoded as 64 hex characters.
# If empty, the server generates and persists a key in `logs/.session.key` (0600).
# In production, ALWAYS set this via a secret so the key survives restarts
# and is not auto-generated per host.
SESSION_ENC_KEY=

# ---------------------------------------------------------------------------
# OpenID Connect single sign-on (optional). Leave OIDC_ISSUER unset to disable
# SSO and use local password login only.
# ---------------------------------------------------------------------------
# OIDC_ISSUER=https://sso.example.com/auth/realms/nereidai
# OIDC_CLIENT_ID=nereidhorizon
# OIDC_CLIENT_SECRET=change-me
# Public callback URL as registered on the IdP:
# OIDC_REDIRECT_URI=https://nereidhorizon.example.com/api/oidc/callback
# OIDC_SCOPES=openid profile email
# OIDC_ROLE_CLAIM=groups
# OIDC_PLATFORM_GROUP=nereidhorizon-platform
# OIDC_PARTNER_GROUP_PREFIX=nereidhorizon-partner-
# Set to false to hide the local password form for regular users. The bootstrap
# admin can always sign in at /login?local=1.
# OIDC_LOCAL_LOGIN_ENABLED=true
# Set to true only in development; disables TLS verification of the IdP.
# OIDC_INSECURE_SKIP_VERIFY=false

# ---------------------------------------------------------------------------
# NereidSphere ticket single sign-on (optional, preferred in suite deployments).
# When NS_BASE_URL is set it takes precedence over direct OIDC. NS_CLIENT_SECRET
# must equal products[horizon].sso_secret in the NereidSphere configuration.
# ---------------------------------------------------------------------------
# NS_BASE_URL=https://nereidsphere.example.com
# NS_PRODUCT_ID=horizon
# NS_CLIENT_SECRET=change-me
# NS_CALLBACK_PATH=/auth/ns-callback

# Open Horizon Exchange base URL (optional default; the user supplies this at setup)
# EXCHANGE_URL=http://192.168.123.133:3090
